# Signs session cookies. Required in production; at least 16 characters.
# Rotating this signs everyone out.
SESSION_SECRET=change-me-to-a-long-random-string

# Where accounts, passkeys and each organisation's GitHub connection are kept.
# The issues themselves live in GitHub, never here.
DATA_DIR=/data

# Passkeys are bound to a domain. Set both in production; in development the
# request origin is used.
# WEBAUTHN_RP_ID=beads.example.com
# WEBAUTHN_ORIGIN=https://beads.example.com

# How often the server polls GitHub for outside changes (min 1000ms).
POLL_INTERVAL_MS=5000
