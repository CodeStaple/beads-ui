# GitHub is the database. These four values address the JSONL file that holds
# every bead; the app reads it, and every write is a commit against it.
GITHUB_TOKEN=ghp_your_token_with_repo_scope
GITHUB_OWNER=smartoptics-dwdm
GITHUB_REPO=beads
GITHUB_BRANCH=beads-db
GITHUB_PATH=.beads/issues.jsonl

# Fallback prefix for generated issue ids when the file is empty (e.g. so-4kd).
BEADS_PREFIX=so

# Author recorded on comments and dependency edges created in the UI.
BEADS_ACTOR=beads-linear

# Commit identity for writes.
GIT_COMMITTER_NAME=beads-linear
GIT_COMMITTER_EMAIL=beads-linear@users.noreply.github.com

# How often the server polls GitHub for outside changes (min 1000ms).
POLL_INTERVAL_MS=5000
